{
  "name": "vibe-slicer-writer-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "node server.js",
    "dev:vercel": "npx vercel dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "share": "npm run build && concurrently \"npm run dev:backend\" \"npx cloudflared tunnel --url http://localhost:4000\"",
    "build": "tsc && vite build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "@types/pg": "^8.20.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vercel": "^58.4.0",
    "vite": "^5.4.10"
  }
}
